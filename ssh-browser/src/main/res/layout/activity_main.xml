<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SSH 服务器"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="主机（如 1.2.3.4 或 ssh.example.com）"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/et_port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="端口（默认 22）"
            android:inputType="number" />

        <EditText
            android:id="@+id/et_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="用户名"
            android:inputType="text" />

        <EditText
            android:id="@+id/et_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="密码（可选；优先用密钥）"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="保存配置" />

        <EditText
            android:id="@+id/et_key_passphrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="私钥口令（可选；私钥无密码则留空）"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/btn_import_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="导入已有私钥（浏览文件）" />

        <Button
            android:id="@+id/btn_genkey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="生成密钥对（RSA-4096）" />

        <TextView
            android:id="@+id/tv_pubkey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_copy_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="复制公钥" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="状态：未连接"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="连接隧道" />

        <Button
            android:id="@+id/btn_open_browser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="打开浏览器" />

        <TextView
            android:id="@+id/tv_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:textSize="12sp"
            android:typeface="monospace" />
    </LinearLayout>
</ScrollView>
